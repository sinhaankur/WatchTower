# WatchTower environment configuration — copy to .env and adjust.
#   cp .env.example .env
# run.sh sources .env automatically. Nothing here is required for a basic
# local dev run except the two auth vars in the first block (they ship with
# working dev defaults). Everything else is optional and documented inline.

# ─────────────────────────────────────────────────────────────────────────────
# Auth (local dev) — these two make first-run "just work". See CLAUDE.md.
# ─────────────────────────────────────────────────────────────────────────────
# Static token for CI/curl/Electron. In dev mode this exact value is also the
# SPA's DEV_FALLBACK_TOKEN, so both sides agree. Dev mode does NOT accept
# arbitrary bearers — this must match on both ends.
WATCHTOWER_API_TOKEN=dev-watchtower-token
# Relaxes auth for local dev only (auto-sets the token above if missing).
# NEVER set this in production.
WATCHTOWER_ALLOW_INSECURE_DEV_AUTH=true

# ─────────────────────────────────────────────────────────────────────────────
# Auth (production) — pick ONE GitHub flow. Leave dev vars above unset in prod.
# ─────────────────────────────────────────────────────────────────────────────
# Signs user-session tokens. Falls back to WATCHTOWER_API_TOKEN if unset, but
# set a dedicated long random value in production.
# WATCHTOWER_AUTH_SECRET=

# GitHub Device Flow — only needs the PUBLIC client ID (safe to embed). This is
# the path shipped in desktop builds; same model as the `gh` CLI.
# WATCHTOWER_GITHUB_DEVICE_CLIENT_ID=

# GitHub Web OAuth — needs BOTH; standard redirect-callback flow. Use when the
# API runs behind a known callback URL.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Generic OIDC login (optional) — Google, GitLab, Okta, Authentik, Keycloak,
# Entra, Auth0, … Any spec-compliant OpenID Connect provider. Shows a
# "Sign in with <provider>" button on the login page when configured.
# Register a confidential OAuth/OIDC client with the provider; set its
# redirect URI to  https://<your-watchtower-host>/oauth/oidc/login/callback
# ─────────────────────────────────────────────────────────────────────────────
# WATCHTOWER_OIDC_ISSUER=https://accounts.google.com     # base issuer URL
# WATCHTOWER_OIDC_CLIENT_ID=
# WATCHTOWER_OIDC_CLIENT_SECRET=
# WATCHTOWER_OIDC_PROVIDER_NAME=Google                   # button label (optional)
# WATCHTOWER_OIDC_SCOPES=openid email profile            # optional; this is the default
# Endpoints are auto-discovered from <issuer>/.well-known/openid-configuration.
# Override only if the provider uses non-standard paths:
# WATCHTOWER_OIDC_AUTHORIZE_URL=
# WATCHTOWER_OIDC_TOKEN_URL=
# WATCHTOWER_OIDC_USERINFO_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Secrets at rest
# ─────────────────────────────────────────────────────────────────────────────
# Fernet key encrypting GitHub PATs / SSH keys / API keys in the DB. If unset,
# one is auto-generated at ~/.watchtower/secret.key (0600) on first start.
# Set explicitly in production so it survives container restarts / re-creates.
# WATCHTOWER_SECRET_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Storage / paths
# ─────────────────────────────────────────────────────────────────────────────
# SQLite by default; set to a Postgres URL for a shared / HA deployment.
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/watchtower
# Where the DB, secret key, backups live. Defaults to ~/.watchtower.
# WATCHTOWER_DATA_DIR=/var/lib/watchtower
# Scratch space for git clones + build artifacts. Defaults to /tmp/watchtower-builds.
# WATCHTOWER_BUILD_DIR=/tmp/watchtower-builds

# ─────────────────────────────────────────────────────────────────────────────
# Server / networking
# ─────────────────────────────────────────────────────────────────────────────
# WATCHTOWER_HOST=0.0.0.0
# WATCHTOWER_PORT=8000
# Comma-separated allowed CORS origins. Wildcards are stripped (credentials mode).
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5173

# ─────────────────────────────────────────────────────────────────────────────
# Build queue (optional) — set REDIS_URL to run durable RQ builds; without it,
# builds run in-process via FastAPI BackgroundTasks.
# ─────────────────────────────────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────────────────────────────────────
# LLM agent + self-heal (optional) — any OpenAI-compatible endpoint. Prefer
# configuring from Settings → AI & Autonomy; these are the env fallback.
# ─────────────────────────────────────────────────────────────────────────────
# WATCHTOWER_LLM_BASE_URL=http://localhost:11434/v1   # Ollama example
# WATCHTOWER_LLM_API_KEY=not-needed-for-local
# WATCHTOWER_LLM_MODEL=gpt-4o-mini
# WATCHTOWER_LLM_ANALYSIS_MODEL=                       # optional tiny self-heal model
# WATCHTOWER_AGENT_READONLY=false                      # true blocks destructive tools
# WATCHTOWER_SELF_HEAL_DISABLE=false                   # kill switch for the self-heal loop
# WATCHTOWER_SELF_HEAL_INTERVAL_SECS=45

# ─────────────────────────────────────────────────────────────────────────────
# Logging / observability (optional)
# ─────────────────────────────────────────────────────────────────────────────
# WATCHTOWER_LOG_FORMAT=text   # or `json` for log aggregators
# SQL_ECHO=false               # true logs every SQL statement (noisy)

# ─────────────────────────────────────────────────────────────────────────────
# Edition / features (optional)
# ─────────────────────────────────────────────────────────────────────────────
# WATCHTOWER_TIER=free         # or `pro`
# WATCHTOWER_ENABLE_DOCS=false # true exposes /docs (OpenAPI UI)

# ─────────────────────────────────────────────────────────────────────────────
# Escape hatches (dev only — loosen SSRF / TLS guards). Do not set in prod.
# ─────────────────────────────────────────────────────────────────────────────
# WATCHTOWER_ALLOW_INTERNAL_HTTP=false   # allow requests to private/loopback hosts (local GHES)
